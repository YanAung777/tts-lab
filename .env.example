# TTS Lab configuration — copy to .env and fill in.
# Never commit a real key.

# --- Engine selection -----------------------------------------------------
# matrix         = the sandbox TTS connector (dev only)
# nvidia-hosted  = Magpie TTS on build.nvidia.com
# nvidia-local   = Magpie TTS NIM container on your own GPU
TTS_ENGINE=matrix

# --- NVIDIA hosted (https://build.nvidia.com/nvidia/magpie-tts-multilingual)
NVIDIA_API_KEY=

# --- NVIDIA local NIM container ---
NVIDIA_TTS_URL=http://localhost:9000

# --- Defaults -------------------------------------------------------------
TTS_VOICE=
TTS_LANGUAGE=en-US
PORT=4173
